# Copy to backend/.env (git-ignored). Every variable is prefixed AURUM_.
# Values below are for LOCAL DEVELOPMENT ONLY.

AURUM_ENV=development
# dev database from docker-compose.dev.yml (synthetic dev-only credentials)
AURUM_DATABASE_URL=postgresql+psycopg://aurumtrace:aurumtrace_dev@localhost:5433/aurumtrace
# generate a real one for any shared environment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AURUM_JWT_SECRET=dev-only-insecure-secret-change-me
AURUM_ACCESS_TOKEN_MINUTES=60
# Vite dev server (frontend). Comma-separated.
AURUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Self-service org sign-up. Must be false when AURUM_ENV=production (enforced at startup).
AURUM_ALLOW_REGISTRATION=true
AURUM_SQL_ECHO=false

# Tests use SQLite unless this is set:
# AURUM_TEST_DATABASE_URL=postgresql+psycopg://aurumtrace:aurumtrace_dev@localhost:5433/aurumtrace_test
